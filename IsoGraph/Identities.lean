theorem E_join_path_cycle (m n : ℕ) :
    (path (m + 1) ∇g cycle (n + 3)).E = m + (n + 3) + (m + 1) * (n + 3) := by
  rw [E_join, E_path, E_cycle, V_path, V_cycle]

theorem cliqueNum_join_path_cycle (m n : ℕ) :
