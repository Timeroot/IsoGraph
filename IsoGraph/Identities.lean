  obtain ⟨n, hn⟩ : ∃ n, ks.length = n + 1 := by
    cases ks with
    | nil => exact absurd rfl hne
    | cons a t => exact ⟨t.length, rfl⟩
  rw [spider_of_all_one h, hn, maxDeg_star]

