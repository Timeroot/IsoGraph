theorem maxDeg_mycielskian_circulant {n k : ℕ} {S : List ℕ} (hn : 0 < n)
    (hk : n * k = 2 * (circulant n S).E) :
    maxDeg (mycielskian (circulant n S)) = max (2 * k) n := by
