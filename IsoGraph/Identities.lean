theorem autCount_mul_le_autCount_lexProduct (G H : CGraph) [DecidableEq G.V]
    [DecidableEq H.V] [Nonempty G.V] [Nonempty H.V] :
    G.autCount * H.autCount ≤ (lexProduct G H).autCount := by
