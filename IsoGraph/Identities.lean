theorem two_mul_E_mycielskian_paley (q : ℕ) [NeZero q] [Fact q.Prime] (hq : q % 4 = 1) :
    2 * (mycielskian (paley q)).E = 3 * (q * ((q - 1) / 2)) + 2 * q := by
