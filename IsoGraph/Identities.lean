  · ext x
    have := congrArg (fun σ : tensorProduct G H ≃cg tensorProduct G H ↦ (σ (x, y₀)).1) h
    simpa using this
  · ext y
    have := congrArg (fun σ : tensorProduct G H ≃cg tensorProduct G H ↦ (σ (x₀, y)).2) h
    simpa using this

