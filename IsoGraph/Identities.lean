  rw [E_mycielskian, V_circulant]

theorem two_mul_E_mycielskian_circulant {n k : ℕ} {S : List ℕ}
    (hk : n * k = 2 * (circulant n S).E) :
    2 * (mycielskian (circulant n S)).E = 3 * (n * k) + 2 * n := by
  rw [E_mycielskian_circulant]
