    [DecidableEq H.V] [Nonempty G.V] [Nonempty H.V] :
    G.autCount * H.autCount ≤ (tensorProduct G H).autCount := by
  obtain ⟨x₀⟩ := ‹Nonempty G.V›
  obtain ⟨y₀⟩ := ‹Nonempty H.V›
