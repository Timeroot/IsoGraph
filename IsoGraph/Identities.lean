theorem cliqueCoverNum_compl_thetaGraph_odd {xs : List ℕ} (hne : xs ≠ [])
    (h : ∀ k ∈ xs, k % 2 = 1) : ((thetaGraph xs)ᶜ).cliqueCoverNum = 2 := by
