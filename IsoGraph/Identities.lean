  have h2 := diameter_lexProduct_le hG hH
  omega

theorem cliqueNum_lineGraph_lexProduct {G H : IsoGraph} (hG : 0 < G.V) (hH : 0 < H.V)
    (h3 : 3 ≤ maxDeg G * H.V + maxDeg H) :
    (lineGraph (G ·g H)).cliqueNum = maxDeg G * H.V + maxDeg H := by
