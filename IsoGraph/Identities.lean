theorem not_isBipartite_lineGraph_lineGraph {G : IsoGraph} {n k : ℕ} (hE : 0 < G.E)
    (h : degSequence G = List.replicate n k) (h3 : 3 ≤ 2 * k - 2) :
    ¬ IsBipartite (lineGraph (lineGraph G)) :=
