import IsoGraph.SmallGraphs.Operators

/-!
# The cubic graphs: independence, clique, chromatic and edge chromatic numbers

Five more of the gallery's cubic graphs get their four co-NP invariants, in the style of
`SmallGraphs.SatValues`: the refutation half by `graph_sat native`, the witness half by a table
found by machine and checked here.

None of the five has a triangle, so `cliqueNum_le_two_of_girth_ne_three` settles `ω = 2` without
the solver; the Gray graph is bipartite and the other four are known not to be, so `χ` needs only
a colouring; and all but the flower snark are class one, so `maxDeg_le_edgeChromNum` is the lower
bound for `χ'`, the snark's `edgeChromNum_flowerSnark` being already in `EdgeColourings`.  Every
independence number goes to the solver.
-/

namespace NamedGraphs

open CGraph

/-! ## The Wagner graph

The Möbius ladder `V₈`, `circulant 8 [1, 4]`: an eight-cycle with the four long diagonals
added.  It is one of the two obstructions in Wagner's theorem, and it is not bipartite even
though its girth is four. -/

@[simp] theorem maxDeg_wagner : wagner.maxDeg = 3 :=
  haveI : Nonempty wagner.V := ⟨(0 : Fin 8)⟩
  (isRegularWith_wagner).maxDeg_eq

/-- **The independence number of the Wagner graph is three.** -/
@[simp] theorem indepNum_wagner : wagner.indepNum = 3 := by
  refine le_antisymm (by graph_sat native) ?_
  exact le_indepNum_of_nodup (G := wagner)
    (l := ([2, 5, 7] : List (Fin 8)))
    (by decide) (by native_decide)

/-- **The Wagner graph has no triangle**, having girth four, so its cliques are its edges. -/
@[simp] theorem cliqueNum_wagner : wagner.cliqueNum = 2 :=
  le_antisymm (cliqueNum_le_two_of_girth_ne_three (by rw [girth_wagner]; decide))
    (two_le_cliqueNum_of_E_pos (by rw [E_wagner]; decide))

/-- A proper three-colouring of the Wagner graph. -/
def wagnerColTable : List ℕ :=
  [0, 1, 0, 1, 2, 0, 1, 2]

/-- The table `wagnerColTable` read as a colouring, clamped into `Fin 3`. -/
def wagnerCol (v : wagner.V) : Fin 3 :=
  ⟨min (wagnerColTable.getD v.1 0) 2, by omega⟩

theorem wagnerCol_proper : ∀ u v : wagner.V,
    wagner.Adj u v = true →
      wagnerCol u ≠ wagnerCol v := by native_decide

/-- **The chromatic number of the Wagner graph is three.** -/
@[simp] theorem chromNum_wagner : wagner.chromNum = 3 :=
  le_antisymm (chromNum_le_of_colouring wagnerCol wagnerCol_proper)
    (three_le_chromNum not_isBipartite_wagner)

/-- A proper three-edge-colouring of the Wagner graph, as a symmetric table; the entries off the
edge set are `0`. -/
def wagnerEdgeColTable : List (List ℕ) :=
  [[0, 0, 0, 0, 1, 0, 0, 2],
   [0, 0, 1, 0, 0, 2, 0, 0],
   [0, 1, 0, 0, 0, 0, 2, 0],
   [0, 0, 0, 0, 2, 0, 0, 1],
   [1, 0, 0, 2, 0, 0, 0, 0],
   [0, 2, 0, 0, 0, 0, 1, 0],
   [0, 0, 2, 0, 0, 1, 0, 0],
   [2, 0, 0, 1, 0, 0, 0, 0]]

/-- The table `wagnerEdgeColTable` read as an edge colouring, clamped into `Fin 3`. -/
def wagnerEdgeCol (x y : wagner.V) : Fin 3 :=
  ⟨min ((wagnerEdgeColTable.getD x.1 []).getD y.1 0) 2, by omega⟩

theorem wagnerEdgeCol_symm : ∀ x y : wagner.V,
    wagnerEdgeCol x y = wagnerEdgeCol y x := by native_decide

theorem wagnerEdgeCol_proper : ∀ u v w : wagner.V,
    wagner.Adj u v = true → wagner.Adj u w = true → v ≠ w →
      wagnerEdgeCol u v ≠ wagnerEdgeCol u w := by native_decide

/-- **The Wagner graph is class one**: `χ' = Δ = 3`. -/
@[simp] theorem edgeChromNum_wagner : wagner.edgeChromNum = 3 := by
  refine le_antisymm ?_ ?_
  · rw [← IsoGraph.edgeChromNum_mk]
    exact IsoGraph.edgeChromNum_mk_le_of_colouring (G := wagner)
      wagnerEdgeCol wagnerEdgeCol_symm
      wagnerEdgeCol_proper
  · have h := maxDeg_le_edgeChromNum wagner
    rwa [maxDeg_wagner] at h

/-! ## The flower snark `J₅`

Twenty vertices, cubic, girth five, and class two — `edgeChromNum_flowerSnark` is what makes it
a snark.  What is left is the other three values. -/

@[simp] theorem maxDeg_flowerSnark : flowerSnark.maxDeg = 3 :=
  haveI : Nonempty flowerSnark.V := ⟨(0 : Fin 20)⟩
  (isRegularWith_flowerSnark).maxDeg_eq

/-- **The independence number of the flower snark is nine.** -/
@[simp] theorem indepNum_flowerSnark : flowerSnark.indepNum = 9 := by
  refine le_antisymm (by graph_sat native) ?_
  exact le_indepNum_of_nodup (G := flowerSnark)
    (l := ([2, 4, 5, 6, 8, 12, 14, 17, 19] : List (Fin 20)))
    (by decide) (by native_decide)

/-- **The flower snark has no triangle**, having girth five, so its cliques are its edges. -/
@[simp] theorem cliqueNum_flowerSnark : flowerSnark.cliqueNum = 2 :=
  le_antisymm (cliqueNum_le_two_of_girth_ne_three (by rw [girth_flowerSnark]; decide))
    (two_le_cliqueNum_of_E_pos (by rw [E_flowerSnark]; decide))

/-- A proper three-colouring of the flower snark. -/
def flowerSnarkVertexColTable : List ℕ :=
  [0, 1, 0, 1, 2, 1, 0, 1, 0, 0, 0, 1, 0, 1, 2, 0, 1, 0, 1, 2]

/-- The table `flowerSnarkVertexColTable` read as a colouring, clamped into `Fin 3`. -/
def flowerSnarkVertexCol (v : flowerSnark.V) : Fin 3 :=
  ⟨min (flowerSnarkVertexColTable.getD v.1 0) 2, by omega⟩

theorem flowerSnarkVertexCol_proper : ∀ u v : flowerSnark.V,
    flowerSnark.Adj u v = true →
      flowerSnarkVertexCol u ≠ flowerSnarkVertexCol v := by native_decide

/-- **The chromatic number of the flower snark is three.** -/
@[simp] theorem chromNum_flowerSnark : flowerSnark.chromNum = 3 :=
  le_antisymm (chromNum_le_of_colouring flowerSnarkVertexCol flowerSnarkVertexCol_proper)
    (three_le_chromNum not_isBipartite_flowerSnark)

