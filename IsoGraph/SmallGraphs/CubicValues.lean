/-- The table `truncatedIcosahedronEdgeColTable` read as an edge colouring, clamped into `Fin 3`. -/
def truncatedIcosahedronEdgeCol (x y : truncatedIcosahedron.V) : Fin 3 :=
  ⟨min ((truncatedIcosahedronEdgeColTable.getD x.1 []).getD y.1 0) 2, by omega⟩

theorem truncatedIcosahedronEdgeCol_symm : ∀ x y : truncatedIcosahedron.V,
    truncatedIcosahedronEdgeCol x y = truncatedIcosahedronEdgeCol y x := by native_decide

theorem truncatedIcosahedronEdgeCol_proper : ∀ u v w : truncatedIcosahedron.V,
    truncatedIcosahedron.Adj u v = true → truncatedIcosahedron.Adj u w = true → v ≠ w →
      truncatedIcosahedronEdgeCol u v ≠ truncatedIcosahedronEdgeCol u w := by native_decide

/-- **The truncated icosahedron is class one**: `χ' = Δ = 3`. -/
@[simp] theorem edgeChromNum_truncatedIcosahedron : truncatedIcosahedron.edgeChromNum = 3 := by
  refine le_antisymm ?_ ?_
  · rw [← IsoGraph.edgeChromNum_mk]
    exact IsoGraph.edgeChromNum_mk_le_of_colouring (G := truncatedIcosahedron)
      truncatedIcosahedronEdgeCol truncatedIcosahedronEdgeCol_symm
      truncatedIcosahedronEdgeCol_proper
  · have h := maxDeg_le_edgeChromNum truncatedIcosahedron
    rwa [maxDeg_truncatedIcosahedron] at h

end NamedGraphs
